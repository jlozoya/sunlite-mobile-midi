{
  "name": "sunlite-mobile-midi",
  "version": "0.3.1",
  "private": true,
  "description": "Installable and update-ready mobile MIDI controller for Sunlite Suite 2.",
  "author": "jlozoya",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "clean": "rimraf dist release",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test:automation": "bun run build:main && node tests/automation-smoke.mjs && node tests/lighting-automation-regression.mjs",
    "check": "bun run format:check && bun run typecheck",
    "build:main": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "build:sidecar": "powershell -ExecutionPolicy Bypass -File scripts/build-python-sidecar.ps1",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "build": "bun run format:check && bun run build:main && bun run build:renderer",
    "dev": "bun run build:main && bun run rebuild:electron && node scripts/dev.mjs",
    "start": "bun run build && bun run rebuild:electron && electron dist/main/main.js",
    "pack": "bun run build && electron-builder --win --x64 --dir --publish never",
    "dist": "bun run dist:win",
    "dist:win": "bun run build && electron-builder --win nsis --x64 --publish never && node scripts/verify-release.mjs",
    "release:win": "bun run dist:win",
    "test:updates": "bun run build:main && node --test tests/updates.test.mjs",
    "dist:portable": "bun run build && electron-builder --win portable --x64 --publish never"
  },
  "dependencies": {
    "@stylexjs/stylex": "^0.9.3",
    "easymidi": "^3.1.0",
    "electron-updater": "^6.3.9",
    "express": "^4.19.2",
    "prolink-connect": "^0.11.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-aria-components": "^1.8.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-stylex": "^0.13.0"
  },
  "overrides": {
    "better-sqlite3": "12.11.1"
  },
  "build": {
    "appId": "com.lozoya.sunlite.mobilemidi",
    "productName": "Sunlite Mobile MIDI",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Sunlite-Mobile-MIDI-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sunlite Mobile MIDI",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "jlozoya",
        "repo": "sunlite-mobile-midi",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jlozoya/sunlite-mobile-midi.git"
  }
}
